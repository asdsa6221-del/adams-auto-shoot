-- AdamsAutoShoot
-- LocalScript (StarterPlayerScripts)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- CONFIG
local jumpHeight = 50       -- how high you visually go
local holdTime = 1.7        -- how long to hold E for perfect bar
local guiEnabled = false

--=======================
-- GUI SETUP
--=======================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AdamsAutoShootGUI"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 200, 0, 50)
Frame.Position = UDim2.new(0, 50, 0, 50)
Frame.BackgroundColor3 = Color3.fromRGB(30, 80, 200)
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, -10, 1, -10)
ToggleBtn.Position = UDim2.new(0, 5, 0, 5)
ToggleBtn.Text = "Autoshoot: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 110, 255)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextScaled = true
ToggleBtn.BorderSizePixel = 0
ToggleBtn.Parent = Frame

ToggleBtn.MouseButton1Click:Connect(function()
	guiEnabled = not guiEnabled
	ToggleBtn.Text = guiEnabled and "Autoshoot: ON" or "Autoshoot: OFF"
end)

--=======================
-- AUTOSHOOT FUNCTION
--=======================
local function DoAutoShoot()
	local hrp = HumanoidRootPart
	local originalPos = hrp.Position

	-- Visual jump instantly to top
	hrp.CFrame = hrp.CFrame + Vector3.new(0, jumpHeight, 0)

	-- Simulate holding E for 1.7 seconds
	RunService.RenderStepped:Wait() -- small wait to register input
	local startTime = tick()
	while tick() - startTime < holdTime do
		-- simulate holding E; in-game mechanics should register it
		RunService.RenderStepped:Wait()
	end

	-- Release E automatically (simulate shot)
	print("Perfect shot executed!") -- placeholder

	-- Return to original position
	hrp.CFrame = CFrame.new(originalPos)
end

--=======================
-- KEYBIND LISTENER
--=======================
UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E and guiEnabled then
		DoAutoShoot()
	end
end)
